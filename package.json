{
  "name": "protocol-buffer-devtools-extension",
  "version": "1.1.2",
  "description": "DevTools panel to inspect gRPC-web traffic.",
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "webpack --mode production --env target=chrome",
    "build:firefox": "webpack --mode production --env target=firefox",
    "dev": "webpack --mode development --watch",
    "lint": "eslint src --ext .ts",
    "compress:chrome": "cd dist/chrome && zip -r ../../release/grpc-panel-chrome-v$npm_package_version.zip .",
    "compress:firefox": "cd dist/firefox && zip -r ../../release/grpc-panel-firefox-v$npm_package_version.zip .",
    "release": "npm run build && mkdir -p release && npm run compress:chrome && npm run compress:firefox"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.54.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^30.2.0",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}